{
  "name": "familie-ef-soknad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:dev-server && npm run set-node-options NODE_ENV=development BRUK_DEV_API=true ENV=localhost node server/build/server-lokal.js",
    "build": "npm run lint && npm run build:prod",
    "build:prod": "tsc --noEmit & vite build",
    "start": "npm run build:dev-server && npm run set-node-options NODE_ENV=development ENV=localhost node server/build/server-lokal.js",
    "start:mock": "npm run build:dev-server && npm run set-node-options NODE_ENV=development BRUK_MOCK_LOKALT=true ENV=localhost node server/build/server-lokal.js",
    "test": "vitest run",
    "vitest": "vitest",
    "lint": "tsc --project ./tsconfig.json --noEmit && eslint './src/**/*.{js,ts,tsx}'",
    "dev:hent-tokens": "npx tsx scripts/hent-dev-token.ts",
    "build:dev-server": "npm --prefix server run build",
    "postinstall": "cd server && npm ci && cd ..",
    "set-node-options": "NODE_OPTIONS='--import=./server/build/register.js --es-module-specifier-resolution=node'"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@grafana/faro-web-tracing": "^2.12.1",
    "@nais/apm": "^0.6.3",
    "@navikt/ds-css": "^8.19.2",
    "@navikt/ds-react": "^8.19.2",
    "@navikt/ds-tokens": "^8.19.2",
    "@navikt/fnrvalidator": "^2.2.1",
    "@navikt/nav-dekoratoren-moduler": "^4.5.0",
    "axios": "^1.20.0",
    "constate": "^4.0.0",
    "date-fns": "^4.4.0",
    "express-rate-limit": "^8.7.1",
    "iso-datestring-validator": "^2.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^15.0.0",
    "react-router": "^7.18.4",
    "use-debounce": "^10.1.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "http-proxy-middleware": "0.2.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "npm": "^11.21.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "constate": {
      "react": "$react"
    },
    "react-day-picker": {
      "react": "$react"
    }
  }
}
